{
  "output": {
    "filePath": "lingodual-full-context.xml",
    "style": "xml",
    "headerText": "Dự án: LingoDual (Học tiếng Nhật N5-N1). Kiến trúc: Clean Architecture. Stack: Flutter, Riverpod, Supabase. Vui lòng đọc các file .md và .sql trước khi phân tích logic code trong lib/."
  },
  "include": [
    "lib/**/*",
    "pubspec.yaml",
    "analysis_options.yaml",
    "*.md",
    "*.sql"
  ],
  "ignore": {
    "customPatterns": [
      "**/build/**",
      "**/.dart_tool/**",
      "**/.git/**",
      "**/android/**",
      "**/ios/**",
      "**/web/**",
      "**/linux/**",
      "**/macos/**",
      "**/windows/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.svg",
      "**/*.ico",
      "**/*.g.dart",
      "**/*.freezed.dart",
      "**/generated/**",
      "pubspec.lock"
    ]
  }
}